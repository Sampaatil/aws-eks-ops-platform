{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backend",
    "frontend",
    "config",
    "nginxConfig",
    "ingress"
  ],
  "properties": {
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "replicas",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^\\d{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z0-9/_-]+@sha256:[a-f0-9]{64}$"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ],
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ],
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ],
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "replicas",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^\\d{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z0-9/_-]+@sha256:[a-f0-9]{64}$"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ],
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ],
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "limits": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ],
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1
                },
                "memory": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "required": [
        "NODE_ENV",
        "PORT",
        "DB_HOST",
        "DB_PORT",
        "DB_NAME",
        "DB_USER",
        "DB_SSL",
        "DB_SSL_CA_PATH"
      ],
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "DB_SSL": {
          "const": "true"
        },
        "DB_HOST": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9.-]+\\.rds\\.amazonaws\\.com$"
        },
        "DB_SSL_CA_PATH": {
          "const": "/etc/rds-ca/global-bundle.pem"
        }
      }
    },
    "nginxConfig": {
      "type": "string",
      "minLength": 40
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "className",
        "annotations"
      ],
      "properties": {
        "className": {
          "const": "alb"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "required": [
            "alb.ingress.kubernetes.io/inbound-cidrs",
            "alb.ingress.kubernetes.io/subnets",
            "alb.ingress.kubernetes.io/scheme",
            "alb.ingress.kubernetes.io/target-type",
            "alb.ingress.kubernetes.io/listen-ports"
          ],
          "properties": {
            "alb.ingress.kubernetes.io/inbound-cidrs": {
              "type": "string",
              "pattern": "^\\d{1,3}(\\.\\d{1,3}){3}/32$"
            },
            "alb.ingress.kubernetes.io/scheme": {
              "const": "internet-facing"
            },
            "alb.ingress.kubernetes.io/target-type": {
              "const": "ip"
            },
            "alb.ingress.kubernetes.io/listen-ports": {
              "const": "[{\"HTTP\":80}]"
            }
          }
        }
      }
    }
  }
}
