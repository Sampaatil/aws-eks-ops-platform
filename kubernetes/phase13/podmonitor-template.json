{
  "apiVersion": "monitoring.coreos.com/v1",
  "kind": "PodMonitor",
  "metadata": {"name": "opsflow-incident-lab", "namespace": "monitoring", "labels": {}},
  "spec": {
    "namespaceSelector": {"matchNames": ["opsflow"]},
    "selector": {"matchLabels": {"app": "backend"}},
    "podMetricsEndpoints": [{"port": "http", "path": "/metrics", "interval": "30s", "scrapeTimeout": "10s"}]
  }
}
